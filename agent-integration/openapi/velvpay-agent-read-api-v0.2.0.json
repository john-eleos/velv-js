{
  "openapi": "3.1.0",
  "info": {
    "title": "VelvPay source-verified agent read API",
    "version": "0.2.0-draft",
    "description": "Conservative GET-only retrieval contracts traced to velv-backend production commit b81302575918fcd91fcdb48627dd4506c6dea161. GET does not mean side-effect-free: authentication counters, API logs and analytics may be written. The v1 locations GET is excluded because its handler may initialize a default location. This file does not prove deployment, feature enablement, credential issuance, live data shape stability or provider availability. Model records allow additional properties because persistence schemas can add fields; callers must expose only an explicit application allowlist."
  },
  "servers": [
    { "url": "https://api.velvpay.com" }
  ],
  "tags": [
    { "name": "Storefront v1" },
    { "name": "Headless commerce v2" }
  ],
  "paths": {
    "/api/v1/service/storefront": {
      "get": {
        "tags": ["Storefront v1"],
        "operationId": "getStorefrontProfileV1",
        "summary": "Read the authenticated merchant storefront profile",
        "security": [{ "ApiKeyCiphertext": [], "PublicKey": [], "RequestReference": [] }],
        "responses": {
          "200": { "$ref": "#/components/responses/StorefrontProfile" },
          "403": { "$ref": "#/components/responses/AuthError" },
          "404": { "$ref": "#/components/responses/ApiError" },
          "422": { "$ref": "#/components/responses/ApiError" },
          "503": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/api/v1/service/storefront/products": {
      "get": {
        "tags": ["Storefront v1"],
        "operationId": "listStorefrontProductsV1",
        "summary": "List products for the authenticated merchant",
        "security": [{ "ApiKeyCiphertext": [], "PublicKey": [], "RequestReference": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/Limit" },
          { "name": "active", "in": "query", "schema": { "type": "boolean" } },
          { "name": "productKind", "in": "query", "schema": { "type": "string", "enum": ["physical", "digital", "service"] } },
          { "$ref": "#/components/parameters/Search" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/PaginatedRecords" },
          "403": { "$ref": "#/components/responses/AuthError" },
          "422": { "$ref": "#/components/responses/ApiError" },
          "503": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/api/v1/service/storefront/products/{productId}": {
      "get": {
        "tags": ["Storefront v1"],
        "operationId": "getStorefrontProductV1",
        "summary": "Read one merchant product",
        "security": [{ "ApiKeyCiphertext": [], "PublicKey": [], "RequestReference": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ProductId" }],
        "responses": {
          "200": { "$ref": "#/components/responses/SingleRecord" },
          "403": { "$ref": "#/components/responses/AuthError" },
          "404": { "$ref": "#/components/responses/ApiError" },
          "503": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/api/v1/service/storefront/inventory": {
      "get": {
        "tags": ["Storefront v1"],
        "operationId": "listStorefrontInventoryV1",
        "summary": "List merchant storefront inventory records",
        "x-data-classification": "merchant-operations-confidential",
        "security": [{ "ApiKeyCiphertext": [], "PublicKey": [], "RequestReference": [] }],
        "parameters": [
          { "name": "locationId", "in": "query", "schema": { "type": "string" } },
          { "name": "productId", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/RecordArray" },
          "403": { "$ref": "#/components/responses/AuthError" },
          "503": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/api/v1/service/storefront/orders": {
      "get": {
        "tags": ["Storefront v1"],
        "operationId": "listStorefrontOrdersV1",
        "summary": "List merchant storefront orders",
        "x-data-classification": "merchant-commerce-confidential",
        "security": [{ "ApiKeyCiphertext": [], "PublicKey": [], "RequestReference": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/Limit" },
          { "name": "locationId", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "string" } },
          { "name": "paid", "in": "query", "schema": { "type": "boolean" } },
          { "name": "fulfilled", "in": "query", "schema": { "type": "boolean" } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/PaginatedRecords" },
          "403": { "$ref": "#/components/responses/AuthError" },
          "503": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/api/v1/service/storefront/orders/{orderId}": {
      "get": {
        "tags": ["Storefront v1"],
        "operationId": "getStorefrontOrderV1",
        "summary": "Read one merchant storefront order",
        "x-data-classification": "merchant-commerce-confidential",
        "security": [{ "ApiKeyCiphertext": [], "PublicKey": [], "RequestReference": [] }],
        "parameters": [{ "$ref": "#/components/parameters/OrderId" }],
        "responses": {
          "200": { "$ref": "#/components/responses/SingleRecord" },
          "403": { "$ref": "#/components/responses/AuthError" },
          "404": { "$ref": "#/components/responses/ApiError" },
          "503": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/api/v2/headless/catalog": {
      "get": {
        "tags": ["Headless commerce v2"],
        "operationId": "listHeadlessCatalogV2",
        "summary": "List catalog items using a scoped headless credential",
        "security": [{ "HeadlessBearer": [] }],
        "x-required-scope": "catalog:read",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/Search" },
          { "name": "status", "in": "query", "schema": { "type": "string" } },
          { "name": "type", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/PaginatedRecords" },
          "401": { "$ref": "#/components/responses/AuthError" },
          "403": { "$ref": "#/components/responses/AuthError" },
          "429": { "$ref": "#/components/responses/ApiError" },
          "503": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/api/v2/headless/orders": {
      "get": {
        "tags": ["Headless commerce v2"],
        "operationId": "listHeadlessOrdersV2",
        "summary": "List orders using a scoped headless credential",
        "x-data-classification": "merchant-commerce-confidential",
        "security": [{ "HeadlessBearer": [] }],
        "x-required-scope": "orders:read",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/Search" },
          { "name": "financialStatus", "in": "query", "schema": { "type": "string" } },
          { "name": "operationalStatus", "in": "query", "schema": { "type": "string" } },
          { "name": "locationId", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/PaginatedRecords" },
          "401": { "$ref": "#/components/responses/AuthError" },
          "403": { "$ref": "#/components/responses/AuthError" },
          "429": { "$ref": "#/components/responses/ApiError" },
          "503": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/api/v2/headless/orders/{orderId}": {
      "get": {
        "tags": ["Headless commerce v2"],
        "operationId": "getHeadlessOrderV2",
        "summary": "Read one order using a scoped headless credential",
        "x-data-classification": "merchant-commerce-confidential",
        "security": [{ "HeadlessBearer": [] }],
        "x-required-scope": "orders:read",
        "parameters": [{ "$ref": "#/components/parameters/OrderId" }],
        "responses": {
          "200": { "$ref": "#/components/responses/SingleRecord" },
          "401": { "$ref": "#/components/responses/AuthError" },
          "403": { "$ref": "#/components/responses/AuthError" },
          "404": { "$ref": "#/components/responses/ApiError" },
          "429": { "$ref": "#/components/responses/ApiError" },
          "503": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/api/v2/headless/customers": {
      "get": {
        "tags": ["Headless commerce v2"],
        "operationId": "listHeadlessCustomersV2",
        "summary": "List commerce customers using a scoped headless credential",
        "x-data-classification": "customer-personal-data",
        "security": [{ "HeadlessBearer": [] }],
        "x-required-scope": "customers:read",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/Search" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/PaginatedRecords" },
          "401": { "$ref": "#/components/responses/AuthError" },
          "403": { "$ref": "#/components/responses/AuthError" },
          "429": { "$ref": "#/components/responses/ApiError" },
          "503": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/api/v2/headless/locations": {
      "get": {
        "tags": ["Headless commerce v2"],
        "operationId": "listHeadlessLocationsV2",
        "summary": "List commerce locations using a scoped headless credential",
        "x-data-classification": "merchant-operations-confidential",
        "security": [{ "HeadlessBearer": [] }],
        "x-required-scope": "locations:read",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/Limit" },
          { "name": "active", "in": "query", "schema": { "type": "boolean" } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/PaginatedRecords" },
          "401": { "$ref": "#/components/responses/AuthError" },
          "403": { "$ref": "#/components/responses/AuthError" },
          "429": { "$ref": "#/components/responses/ApiError" },
          "503": { "$ref": "#/components/responses/ApiError" }
        }
      }
    },
    "/api/v2/headless/inventory": {
      "get": {
        "tags": ["Headless commerce v2"],
        "operationId": "listHeadlessInventoryV2",
        "summary": "List commerce inventory using a scoped headless credential",
        "x-data-classification": "merchant-operations-confidential",
        "security": [{ "HeadlessBearer": [] }],
        "x-required-scope": "inventory:read",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/Search" },
          { "name": "itemId", "in": "query", "schema": { "type": "string", "maxLength": 200 } }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/PaginatedRecords" },
          "401": { "$ref": "#/components/responses/AuthError" },
          "403": { "$ref": "#/components/responses/AuthError" },
          "429": { "$ref": "#/components/responses/ApiError" },
          "503": { "$ref": "#/components/responses/ApiError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyCiphertext": { "type": "apiKey", "in": "header", "name": "api-key", "description": "CryptoJS AES ciphertext generated on a trusted server." },
      "PublicKey": { "type": "apiKey", "in": "header", "name": "public-key" },
      "RequestReference": { "type": "apiKey", "in": "header", "name": "reference-id" },
      "HeadlessBearer": { "type": "http", "scheme": "bearer", "description": "Independently revocable vch_ headless credential with the operation's required scope." }
    },
    "parameters": {
      "Page": { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 } },
      "Limit": { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 } },
      "Search": { "name": "search", "in": "query", "schema": { "type": "string" } },
      "ProductId": { "name": "productId", "in": "path", "required": true, "schema": { "type": "string" } },
      "OrderId": { "name": "orderId", "in": "path", "required": true, "schema": { "type": "string" } }
    },
    "schemas": {
      "OpenRecord": { "type": "object", "additionalProperties": true },
      "Meta": {
        "type": "object",
        "required": ["page", "limit", "total", "hasMore"],
        "properties": {
          "page": { "type": "integer" },
          "limit": { "type": "integer" },
          "total": { "type": "integer" },
          "hasMore": { "type": "boolean" }
        },
        "additionalProperties": false
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": ["status", "error"],
        "properties": {
          "status": { "const": "error" },
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "details": {} },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "responses": {
      "StorefrontProfile": {
        "description": "Storefront profile envelope",
        "content": { "application/json": { "schema": { "type": "object", "required": ["status", "data"], "properties": { "status": { "const": "success" }, "data": { "type": "object", "properties": { "companyName": { "type": ["string", "null"] }, "storefrontLink": { "type": ["string", "null"] }, "customDomain": { "type": ["string", "null"] }, "logoUrl": { "type": ["string", "null"] }, "branding": { "type": ["object", "null"], "additionalProperties": true } }, "additionalProperties": false } }, "additionalProperties": false } } }
      },
      "SingleRecord": {
        "description": "Single source record; unknown fields must be tolerated",
        "content": { "application/json": { "schema": { "type": "object", "required": ["status", "data"], "properties": { "status": { "const": "success" }, "data": { "$ref": "#/components/schemas/OpenRecord" } }, "additionalProperties": false } } }
      },
      "RecordArray": {
        "description": "Record array",
        "content": { "application/json": { "schema": { "type": "object", "required": ["status", "data"], "properties": { "status": { "const": "success" }, "data": { "type": "array", "items": { "$ref": "#/components/schemas/OpenRecord" } } }, "additionalProperties": false } } }
      },
      "PaginatedRecords": {
        "description": "Paginated record envelope",
        "content": { "application/json": { "schema": { "type": "object", "required": ["status", "data", "meta"], "properties": { "status": { "const": "success" }, "data": { "type": "array", "items": { "$ref": "#/components/schemas/OpenRecord" } }, "meta": { "$ref": "#/components/schemas/Meta" } }, "additionalProperties": false } } }
      },
      "AuthError": { "description": "Authentication, account, scope or feature denial", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
      "ApiError": { "description": "Documented error envelope; v1 authentication middleware may use a legacy status/reason/err shape", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } }
    }
  }
}
